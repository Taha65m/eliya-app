{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eliya-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8b4346dd-609b-48d8-895c-e7249405d57f","database_name": "Eliya-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "2c0b930e20b24bf0bd6fd70e2d824b4f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
